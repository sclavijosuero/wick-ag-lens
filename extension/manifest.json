{
  "manifest_version": 3,
  "name": "WICK-AG-Lens: Accessibility Inspector",
  "version": "3.0.0",
  "description": "Visual accessibility inspector for Web Developers and QA.",
  "author": "Sebastian Clavijo Suero",
  "devtools_page": "devtools.html",
  "icons": {
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "core/shared-utils.js", 
        "core/a11y-config.js", 
        "content/content.js"
      ],
      "all_frames": true
    }
  ]
}