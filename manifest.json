{
  "manifest_version": 3,
  "name": "WICK-AG-Lens: Accessibility Inspector",
  "version": "2.2.0",
  "description": "Visual accessibility inspector for Web Developers and QA.",
  "author": "Sebastian Clavijo Suero",
  "devtools_page": "devtools.html",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config/a11y-config.js", "content/content.js"],
      "all_frames": true
    }
  ]
}